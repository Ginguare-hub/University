Procedure UpdateBullets(DeltaTime: Double);
Var
    Iterator, Temp: PTBulletNode;
    CurrBullet: PTBullet;
    TargetedEnemy: PTEnemy;
    Damage, SpeedMult: Double;
    TurretTypeID, TargetCellX, TargetCellY, I: Integer;
Begin
    Iterator := BulletList.Head;

    While Iterator <> Nil Do
    Begin
        CurrBullet := @Iterator^.Bullet;
        CurrBullet^.DistanceProgress := CurrBullet^.DistanceProgress + CurrBullet^.Speed * DeltaTime;

        If (CurrBullet^.DistanceProgress > 1) Then
        Begin
            Temp := Iterator;
            Iterator := Iterator^.Next;
            TurretTypeID := Ord(MapData[CurrBullet^.TurretCellX, CurrBullet^.TurretCellY].Turret.TurretType);
            Damage := BULLET_DAMAGE[TurretTypeID];
            SpeedMult := BULLET_SLOW[TurretTypeID];

            If (IS_BULLET_AOE[TurretTypeID]) Then
            Begin
                If (CurrBullet^.IsTracking) Then
                Begin
                    TargetCellX := CurrBullet^.TargetedEnemy^.CellX;
                    TargetCellY := CurrBullet^.TargetedEnemy^.CellY;
                End
                Else
                Begin
                    TargetCellX := CurrBullet^.TargetCellX;
                    TargetCellY := CurrBullet^.TargetCellY;
                End;
            End
            Else
            Begin
                If (CurrBullet^.IsTracking) Then
                Begin
                    TargetedEnemy := CurrBullet^.TargetedEnemy;
                End
                Else
                Begin
                    TargetCellX := CurrBullet^.TargetCellX;
                    TargetCellY := CurrBullet^.TargetCellY;

                    TargetedEnemy := Nil;

                    // Поиск врага в клетке
                    For I := 0 To High(Enemies) Do
                    Begin
                        If (Enemies[I].IsAlive And (Enemies[I].CellX = TargetCellX) And (Enemies[I].CellX = TargetCellX)) Then
                        Begin
                            TargetedEnemy := @Enemies[I];
                        End;
                    End;


                End;

                If (TargetedEnemy <> Nil) Then
                Begin
                    TargetedEnemy^.Health := TargetedEnemy^.Health - Damage;
                    TargetedEnemy^.Speed := TargetedEnemy^.Speed * SpeedMult;
                End;
            End;

            Delete(BulletList, Temp);
        End
        Else
        Begin
            Iterator := Iterator^.Next;
        End;
    End;
End;

Procedure UpdateTurrets(DeltaTime: Double);
Var
    I, J, K, DistanceSquared, TurretID: Integer;
    IsToStop: Boolean;
    Bullet: TBullet;
Begin
    IsToStop := False;

    For I := 0 To MAP_WIDTH - 1 Do
    Begin
        For J := 0 To MAP_HEIGHT - 1 Do
        Begin
            If (MapData[I, J].Turret.TurretType <> TurrNone) Then
            Begin

                MapData[I, J].Turret.ReloadProgress := MapData[I, J].Turret.ReloadProgress + (MapData[I, J].Turret.FireRate * DeltaTime);

                If (MapData[I, J].Turret.ReloadProgress > 1) Then
                Begin
                    // Поиск врага
                    K := 0;
                    IsToStop := False;
                    While ((K < High(Enemies)) And Not IsToStop) Do
                    Begin

                        If (Enemies[K].IsAlive) Then
                        Begin
                            DistanceSquared := CalculateDistanceSquared(I, J, Enemies[K].CellX, Enemies[K].CellY);

                            If ((DistanceSquared < (MapData[I, J].Turret.Radius * MapData[I, J].Turret.Radius))) Then
                            Begin
                                IsToStop := True;
                            End
                            Else
                            Begin
                                Inc(K);
                            End;
                        End
                        Else
                        Begin
                            Inc(K);
                        End;
                    End;

                    If (IsToStop) Then
                    Begin
                        While (MapData[I, J].Turret.ReloadProgress > 1) Do   // Создаём пулю
                        Begin
                            MapData[I, J].Turret.ReloadProgress := MapData[I, J].Turret.ReloadProgress - 1;
                            TurretID := Ord(MapData[I, J].Turret.TurretType);

                            // BulletInit
                            Bullet.DistanceProgress := 0;
                            Bullet.Speed := BULLET_SPEED[TurretID];
                            Bullet.IsTracking := IS_BULLET_TRACKING[TurretID];

                            If Bullet.IsTracking Then
                            Begin
                                Bullet.TargetedEnemy := @Enemies[K];
                            End
                            Else
                            Begin
                                Bullet.TargetCellX := Enemies[K].CellX;
                                Bullet.TargetCellY := Enemies[K].CellY;
                            End;

                            Bullet.TurretCellX := I;
                            Bullet.TurretCellY := J;
                            //

                            //ShowMessage(Format('Error: Funny Error! - I = %d; J = %d, FP = %f', [I, J, MapData[I, J].Turret.FireProgress]));

                            Append(BulletList, Bullet);
                        End;

                    End;

                End;
            End;

        End;
    End;

End;

