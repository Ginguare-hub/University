Procedure DrawEnemies(Canvas: TCanvas);
Var
    I: Integer;
    ScreenX, ScreenY, DeltaX, DeltaY: Integer;
Begin
    For I := 0 To Length(Enemies) - 1 Do
    Begin
        DeltaX := 0;
        DeltaY := 0;

        case MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection of
            DirUp:
                DeltaY := 1;
            DirDown:
                DeltaY := -1;
            DirRight:
                DeltaX := 1;
            DirLeft:
                DeltaX := -1;
        end;

        // Враги перемещаются красиво, но становяться на вокую клетку ТОЛЬКО окогда наступают на её середину
        ScreenX := Trunc((Enemies[I].CellX + (Enemies[I].DistanceProgress { - 0.5}) * DeltaX) * CELL_SIZE);
        ScreenY := Trunc((MAP_HEIGHT - 1 - Enemies[I].CellY - (Enemies[I].DistanceProgress {- 0.5}) * DeltaY) * CELL_SIZE);

        If Enemies[I].EnemyType = EnCommon Then
            Canvas.Brush.Color := ClBlue
        Else
            If Enemies[I].EnemyType = EnHeavy Then
                Canvas.Brush.Color := ClRed
            Else
                Canvas.Brush.Color := ClGreen;

        Canvas.Ellipse(ScreenX + 5, ScreenY + 5, ScreenX + CELL_SIZE - 5, ScreenY + CELL_SIZE - 5);
    End;
End;

