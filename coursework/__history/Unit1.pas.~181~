Procedure SpawnEnemy(TemplateIndex: Integer);
Var
    NewEnemy: TEnemy;
    StartX, StartY, EnemyCount: Integer;
Begin
    If FindStartCell(StartX, StartY) Then
    Begin
        NewEnemy := EnemyTemplates[TemplateIndex];
        NewEnemy.CellX := StartX;
        NewEnemy.CellY := StartY;

        EnemyCount := Length(Enemies);
        SetLength(Enemies, EnemyCount + 1);
        Enemies[EnemyCount] := NewEnemy;
    End;
End;

//-------------------------------------------------------------------
//Обновление позиций врагов
//-------------------------------------------------------------------
Procedure UpdateEnemies(DeltaTime: Double);
Var
    I: Integer;
    MoveDistance: Double;
    FullCells: Integer;
Begin
    I := 0;
    While I < Length(Enemies) Do
    Begin
        Enemies[I].DistanceProgress := Enemies[I].DistanceProgress + Enemies[I].Speed * DeltaTime;

        //Сколько целых клеток нужно пройти
        FullCells := Round(MoveDistance);
        If FullCells < 1 Then
            FullCells := 1;

        While Enemies[I].DistanceProgress > 1 Do
        Begin

            //Обновляем направление на новой клетке
//            If (Enemies[I].CellX >= 0) And (Enemies[I].CellX < MAP_WIDTH) And (Enemies[I].CellY >= 0) And
//                (Enemies[I].CellY < MAP_HEIGHT) Then
//            Begin
//                If MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection <> TDirection.DirNone Then
//                    Enemies[I].Direction := MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection;
//            End;

            JumpToNextCell(MapData, Enemies[I].CellX, Enemies[I].CellY);

            Enemies[I].DistanceProgress := Enemies[I].DistanceProgress - 1;
        End;

        //Проверка достижения базы
        If (Enemies[I].CellX >= 0) And (Enemies[I].CellX < MAP_WIDTH) And (Enemies[I].CellY >= 0) And (Enemies[I].CellY < MAP_HEIGHT) Then
        Begin
            If MapData[Enemies[I].CellX, Enemies[I].CellY].TypeOfGround = TGroundType.GtBase Then
            Begin
                //Враг достиг базы - удаляем
                Enemies[I] := Enemies[Length(Enemies) - 1];
                SetLength(Enemies, Length(Enemies) - 1);
            End
            Else
            Begin
                I := I + 1;
            End;
        End
        Else
        Begin
            I := I + 1;
        End;
    End;
End;

//-------------------------------------------------------------------
