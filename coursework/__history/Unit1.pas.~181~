Procedure SetEnemyLineCharacteristics(Var LineHead: TLineNode);
Const
    STD_CELLS_POS: Integer = -1;
    STD_DISTANCE_PROGRESS: Integer = 0;

    COMMON_MAX_HEALTH: Integer = 100;
    COMMON_SPEED: Double = 1;
    COMMON_REWARD: Integer = 50;

    HEAVY_MAX_HEALTH: Integer = 200;
    HEAVY_SPEED: Double = 0.5;
    HEAVY_REWARD: Integer = 125;

    FAST_MAX_HEALTH: Integer = 50;
    FAST_SPEED: Double = 1.5;
    FAST_REWARD: Integer = 75;
Var
    Curr: TLineNode;
Begin
    Curr := LineHead^.Next;

    While Curr <> Nil Do
    Begin

        Curr^.Enemy.CellX := STD_CELLS_POS;
        Curr^.Enemy.CellY := STD_CELLS_POS;
        Curr^.Enemy.DistanceProgress := STD_DISTANCE_PROGRESS;

        Case Curr^.Enemy.EnemyType Of
            EnCommon:
            Begin
                Curr^.Enemy.Health := COMMON_MAX_HEALTH;
                Curr^.Enemy.MaxHealth := COMMON_MAX_HEALTH;
                Curr^.Enemy.Speed := COMMON_SPEED;
                Curr^.Enemy.Reward := COMMON_REWARD;
            End;

            EnHeavy:
            Begin
                Curr^.Enemy.Health := HEAVY_MAX_HEALTH;
                Curr^.Enemy.MaxHealth := HEAVY_MAX_HEALTH;
                Curr^.Enemy.Speed := HEAVY_SPEED;
                Curr^.Enemy.Reward := HEAVY_REWARD;
            End;

            EnFast:
            Begin
                Curr^.Enemy.Health := FAST_MAX_HEALTH;
                Curr^.Enemy.MaxHealth := FAST_MAX_HEALTH;
                Curr^.Enemy.Speed := FAST_SPEED;
                Curr^.Enemy.Reward := FAST_REWARD;
            End;
        End;

        Curr := Curr^.Next;
    End;

End;

Procedure CreateEnemyLine1(Var LineHead1: TLineNode);
Var
    LineEnemyCurr, NewEnemy: TLineNode;
Begin
    LineHead1 := Nil;
    New(LineHead1);
    LineHead1^.Enemy.EnemyType := TEnemyType.EnNone; // Инициализация первого "пустого" элемента списка

    LineEnemyCurr := LineHead1;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnCommon;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnHeavy;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnCommon;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnFast;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnCommon;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    New(NewEnemy);
    NewEnemy^.Enemy.EnemyType := EnHeavy;
    LineEnemyCurr^.Next := NewEnemy;
    LineEnemyCurr := LineEnemyCurr^.Next;

    LineEnemyCurr^.Next := Nil;
End;

Procedure ReadEnemySpawns();
Var
    ReadedFile: TextFile;
    Len: Integer;
    Element: TEnemySpawns;
Begin
    Len := 0;
    //AssignFile(ReadedFile, '.\..\..\EnemySpawnsData.txt');
    AssignFile(ReadedFile, 'C:\Users\Vlad\Desktop\MyFile1.txt');

    Reset(ReadedFile);

    While (Not EOF(ReadedFile)) Do
    Begin
        Inc(Len);
        SetLength(EnemySpawnsArray, Len);

        Read(Element.EnemyID);
        Read(Element.StartTime);
        Read(Element.EndTime);
        Read(Element.EnemyCount);

        Element.EnemyCountCurrent := 0;

        EnemySpawnsArray[Len-1] := Element;
    End;

    CloseFile(ReadedFile);
End;

