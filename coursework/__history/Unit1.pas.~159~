Procedure InitEnemyTemplates();
Begin
    SetLength(EnemyTemplates, 3);

    EnemyTemplates[0].EnemyType := EnCommon;
    EnemyTemplates[0].Health := 100;
    EnemyTemplates[0].MaxHealth := 100;
    EnemyTemplates[0].Speed := 2.0;
