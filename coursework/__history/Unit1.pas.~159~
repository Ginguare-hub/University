Procedure ClearMap(Var Map: TMatrixOfMap);
Var
    I, J: Integer;
Begin
    For I := Low(Map) To High(Map) Do
    Begin
        For J := Low(Map[I]) To High(Map[I]) Do
        Begin
            Map[I, J].TypeOfGround := TGroundType.GtGrass;
            Map[I, J].TypeOfTurret := TTurretType.TurrNone;
            Map[I, J].EnemyDirection := TDirection.DirNone;
            Map[I, J].IsAvailibleForTurret := False;
        End;
    End;
End;

Function SetMap1(): TMatrixOfMap;
Var
    MapData: TMatrixOfMap;
    I, J: Integer;
Begin
    ClearMap(MapData);

    For J := 0 To 4 Do
    Begin
        MapData[3, J].TypeOfGround := TGroundType.GtRoad;
    End;

    For I := 3 To 12 Do
    Begin
        MapData[I, 4].TypeOfGround := TGroundType.GtRoad;
    End;

    For J := 4 To 10 Do
    Begin
        MapData[12, J].TypeOfGround := TGroundType.GtRoad;
    End;

    For I := 12 DownTo 5 Do
    Begin
        MapData[I, 10].TypeOfGround := TGroundType.GtRoad;
    End;

    MapData[5, 11].TypeOfGround := TGroundType.GtRoad;

    //База
    For I := 4 To 6 Do
    Begin
        MapData[I, 12].TypeOfGround := TGroundType.GtBase;
        MapData[I, 13].TypeOfGround := TGroundType.GtBase;
    End;

    SetMap1 := MapData;
End;

//-------------------------------------------------------------------
//Поиск стартовой клетки (клетка Road на краю поля)
//-------------------------------------------------------------------
Function FindStartCell(Var StartX, StartY: Integer): Boolean;
Var
    I, J: Integer;
    Found: Boolean;
    NeighborCount: Integer;
Begin
    Found := False;
    StartX := -1;
    StartY := -1;

    For I := 0 To High(MapData) Do
    Begin
        For J := 0 To High(MapData[I]) Do
        Begin
            If ((I = Low(MapData)) Or (I = High(MapData)) Or (J = Low(MapData[I])) Or (J = High(MapData[I]))) Then
            Begin
                If (MapData[I, J].TypeOfGround = TGroundType.GtRoad) Then
                Begin
                    Found := True;
                    StartX := I;
                    StartY := J;
                End;
            End;
        End;
    End;

    If (StartX = -1) Then
        ShowMessage('Error: First Cell Not Found');

    FindStartCell := Found;
End;

//-------------------------------------------------------------------
//Расчёт направлений для дорог
//-------------------------------------------------------------------
Function FindFirstDirection(Map: TMatrixOfMap): TDirection;
var
    X, Y: Integer;
begin
    FindStartCell(X, Y);

    If (X = Low(Map)) Then
    Begin
        FindFirstDirection := DirRight;
    End
    Else
        If (X = High(Map)) Then
        Begin
            FindFirstDirection := DirLeft;
        End
        Else
            If (Y = Low(Map[X])) Then
            Begin
            	FindFirstDirection := DirUp;
            End
            Else
                If (Y = High(Map[X])) Then
                Begin
                    FindFirstDirection := DirDown;
                End;
end;

Procedure JumpToNextCell(Map: TMatrixOfMap; Var X, Y: Integer);
Begin
    If Not(Map[X, Y].EnemyDirection = DirNone) Then
    Begin
        If ( (Map[X, Y].EnemyDirection = DirRight) And (X < High(Map)) ) Then
        Begin
            Inc(X);
        End
        Else
            If ( (Map[X, Y].EnemyDirection = TDirection.DirUp) And (Y < High(Map)) ) Then
            Begin
                Inc(Y);
            End
            Else
                If ( (Map[X, Y].EnemyDirection = TDirection.DirLeft) And (X > Low(Map)) ) Then
                Begin
                    Dec(X);
                End
                Else
                    If ( (Map[X, Y].EnemyDirection = TDirection.DirDown) And (Y > Low(Map)) ) Then
                    Begin
                        Dec(Y);
                    End;
    End;
End;

// Принимает "начальную" клетку с определённым направлением, возвращает следующую клетку X Y
// а также Boolean как признак конца
// Переходит на след. клетку
Function SetDirection(Var Map: TMatrixOfMap; Var X, Y: Integer): Boolean;
Var
    IsEnd: Boolean;
    CheckX, CheckY: Integer;
    PrevDir: TDirection;
Begin
    IsEnd := True;
    PrevDir := Map[X, Y].EnemyDirection;

    JumpToNextCell(Map, X, Y);
    CheckX := X;
    CheckY := Y;

    If (PrevDir = TDirection.DirRight) Then
    Begin
        Map[X, Y].EnemyDirection := TDirection.DirDown;
    End
    Else
    Begin
        Map[X, Y].EnemyDirection := Pred(PrevDir);
    End;

    JumpToNextCell(Map, CheckX, CheckY);
    If ( Not((CheckX = X) And (CheckY = Y)) And (Map[CheckX, CheckY].TypeOfGround = GtRoad) ) Then
    Begin
        IsEnd := False;
    End
    Else
    Begin
        CheckX := X;
        CheckY := Y;
        Map[X, Y].EnemyDirection := PrevDir;
        JumpToNextCell(Map, CheckX, CheckY);
        If ( Not((CheckX = X) And (CheckY = Y)) And (Map[CheckX, CheckY].TypeOfGround = GtRoad) ) Then
        Begin
            IsEnd := False;
        End
        Else
        Begin
            CheckX := X;
            CheckY := Y;
            If (PrevDir = TDirection.DirDown) Then
            Begin
                Map[X, Y].EnemyDirection := TDirection.DirRight;
            End
            Else
            Begin
                Map[X, Y].EnemyDirection := Succ(PrevDir);
            End;

            JumpToNextCell(Map, CheckX, CheckY);
            If ( Not((CheckX = X) And (CheckY = Y)) And (Map[CheckX, CheckY].TypeOfGround = GtRoad) ) Then
            Begin
                IsEnd := False;
            End;
        End;

    End;

    If (IsEnd) Then
    Begin
        Map[X, Y].EnemyDirection := DirNone;
    End;

    SetDirection := IsEnd;
End;

Procedure CalculateEnemyDirections(Var Map: TMatrixOfMap);
Var
    X, Y, StartX, StartY: Integer;
    HasTop, HasBottom, HasLeft, HasRight: Boolean;
    IsStop: Boolean;
Begin
    IsStop := False;
    StartX := 0;
    StartY := 0;

    FindStartCell(StartX, StartY);

    X := StartX;
    Y := StartY;

    Map[X, Y].EnemyDirection := FindFirstDirection(Map);

    Repeat
        IsStop := SetDirection(Map, X, Y);
    Until IsStop;
End;

