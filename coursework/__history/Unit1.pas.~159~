    EnemyTemplates[1].EnemyType := EnHeavy;
    EnemyTemplates[1].Health := 250;
    EnemyTemplates[1].MaxHealth := 250;
    EnemyTemplates[1].Speed := 1.0;
    EnemyTemplates[1].Reward := 100;

    EnemyTemplates[2].EnemyType := EnFast;
    EnemyTemplates[2].Health := 50;
    EnemyTemplates[2].MaxHealth := 50;
    EnemyTemplates[2].Speed := 4.0;
    EnemyTemplates[2].Reward := 75;
End;

//-------------------------------------------------------------------
//Создание врага
//-------------------------------------------------------------------
Procedure SpawnEnemy(TemplateIndex: Integer);
Var
    NewEnemy: TEnemy;
    StartX, StartY: Integer;
    EnemyCount: Integer;
Begin
    If FindStartCell(StartX, StartY) Then
    Begin
        NewEnemy := EnemyTemplates[TemplateIndex];
        NewEnemy.CellX := StartX;
        NewEnemy.CellY := StartY;

        EnemyCount := Length(Enemies);
        SetLength(Enemies, EnemyCount + 1);
        Enemies[EnemyCount] := NewEnemy;
    End;
End;

//-------------------------------------------------------------------
//Обновление позиций врагов
//-------------------------------------------------------------------
Procedure UpdateEnemies(DeltaTime: Double);
Var
    I: Integer;
    MoveDistance: Double;
    FullCells: Integer;
Begin
    I := 0;
    While I < Length(Enemies) Do
    Begin
        Enemies[I].DistanceProgress := Enemies[I].DistanceProgress + Enemies[I].Speed * DeltaTime;

        //Сколько целых клеток нужно пройти
        FullCells := Round(MoveDistance);
        If FullCells < 1 Then
            FullCells := 1;

        While Enemies[I].DistanceProgress > 1 Do
        Begin

            //Обновляем направление на новой клетке
//            If (Enemies[I].CellX >= 0) And (Enemies[I].CellX < MAP_WIDTH) And (Enemies[I].CellY >= 0) And
//                (Enemies[I].CellY < MAP_HEIGHT) Then
//            Begin
//                If MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection <> TDirection.DirNone Then
//                    Enemies[I].Direction := MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection;
//            End;

            JumpToNextCell(MapData, Enemies[I].CellX, Enemies[I].CellY);

            Enemies[I].DistanceProgress := Enemies[I].DistanceProgress - 1;
        End;

        //Проверка достижения базы
        If (Enemies[I].CellX >= 0) And (Enemies[I].CellX < MAP_WIDTH) And (Enemies[I].CellY >= 0) And (Enemies[I].CellY < MAP_HEIGHT) Then
        Begin
            If MapData[Enemies[I].CellX, Enemies[I].CellY].TypeOfGround = TGroundType.GtBase Then
            Begin
                //Враг достиг базы - удаляем
                Enemies[I] := Enemies[Length(Enemies) - 1];
                SetLength(Enemies, Length(Enemies) - 1);
            End
            Else
            Begin
                I := I + 1;
            End;
        End
        Else
        Begin
            I := I + 1;
        End;
    End;
End;

//-------------------------------------------------------------------
//Отрисовка врагов
//-------------------------------------------------------------------
Procedure DrawEnemies(Canvas: TCanvas);
Var
    I: Integer;
    ScreenX, ScreenY, DeltaX, DeltaY: Integer;
Begin
    For I := 0 To Length(Enemies) - 1 Do
    Begin
        DeltaX := 0;
        DeltaY := 0;

        case MapData[Enemies[I].CellX, Enemies[I].CellY].EnemyDirection of
            DirUp:
                DeltaY := 1;
            DirDown:
                DeltaY := -1;
            DirRight:
                DeltaX := 1;
            DirLeft:
                DeltaX := -1;
        end;

        // Враги перемещаются красиво, но становяться на вокую клетку ТОЛЬКО окогда наступают на её середину
        ScreenX := Trunc((Enemies[I].CellX + (Enemies[I].DistanceProgress { - 0.5}) * DeltaX) * CELL_SIZE);
        ScreenY := Trunc((MAP_HEIGHT - 1 - Enemies[I].CellY - (Enemies[I].DistanceProgress {- 0.5}) * DeltaY) * CELL_SIZE);

        If Enemies[I].EnemyType = EnCommon Then
            Canvas.Brush.Color := ClBlue
        Else
            If Enemies[I].EnemyType = EnHeavy Then
                Canvas.Brush.Color := ClRed
            Else
                Canvas.Brush.Color := ClGreen;

        Canvas.Ellipse(ScreenX + 5, ScreenY + 5, ScreenX + CELL_SIZE - 5, ScreenY + CELL_SIZE - 5);
    End;
End;

