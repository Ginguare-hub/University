Unit Unit1;

Interface

Uses
    Winapi.Windows,
    Winapi.Messages,
    System.SysUtils,
    System.Variants,
    System.Classes,
    Vcl.Graphics,
    Vcl.Controls,
    Vcl.Forms,
    Vcl.Dialogs,
    Vcl.ExtCtrls,
    Vcl.ComCtrls, Vcl.StdCtrls;

Type
    TForm1 = Class(TForm)
        PaintBox1: TPaintBox;
        Timer1: TTimer;
    TimeLabel: TLabel;
        Procedure PaintBox1Paint(Sender: TObject);
        Procedure Timer1Timer(Sender: TObject);
        Procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);

    Private
        { Private declarations }
    Public
        { Public declarations }
    End;

Var
    Form1: TForm1;

Implementation

{$R *.dfm}

Const
    CELL_SIZE = 64; //пикселей
    MAP_WIDTH = 16; //клеток по горизонтали
    MAP_HEIGHT = 16; //клеток по вертикали

Var
    GrassTex{, RoadTex, TowerTex}: TBitmap;
    MapData: Array [0 .. MAP_WIDTH - 1, 0 .. MAP_HEIGHT - 1] Of Integer;  //0 Ц пусто, 1 Ц дорога, 2 Ц место дл€ башни и т.д.
    GameTime: Integer; // врем€ в секундах (или миллисекундах)

Procedure TForm1.FormCreate(Sender: TObject);
Begin
    GrassTex := TBitmap.Create;
    GameTime := 0;
//    RoadTex := TBitmap.Create;
//    TowerTex := TBitmap.Create;

    GrassTex.LoadFromFile('C:/GitHub/University/coursework/test_textures/grass_texture.bmp');
//    RoadTex.LoadFromFile('road.bmp');
//    TowerTex.LoadFromFile('tower.bmp');
End;

procedure TForm1.FormDestroy(Sender: TObject);
begin
    GrassTex.Free;
end;

Procedure TForm1.PaintBox1Paint(Sender: TObject);
Var
    I, J: Integer;
    CellRect: TRect;
Begin
    With PaintBox1.Canvas Do
    Begin
        For I := 0 To MAP_WIDTH - 1 Do
        Begin
            For J := 0 To MAP_HEIGHT - 1 Do
            Begin
                CellRect := Rect(I * CELL_SIZE, J * CELL_SIZE,
                                 (I + 1) * CELL_SIZE, (J + 1) * CELL_SIZE);
                Case MapData[I, J] Of
                    0:
                        Begin
                            StretchDraw(CellRect, GrassTex);
                        End;
                    1:
                        Begin
                            Brush.Color := ClGray;
                            FillRect(CellRect);
                        End;
                    2:
                        Begin
                            Brush.Color := ClBlue;
                            FillRect(CellRect);
                        End;
                Else
                    Begin
                        Brush.Color := ClBlack;
                        FillRect(CellRect);
                    End;
                End;
                Pen.Color := ClWhite;
                //Rectangle(CellRect.Left, CellRect.Top, CellRect.Right, CellRect.Bottom);
            End;
        End;
    End;
End;

Procedure TForm1.Timer1Timer(Sender: TObject);
Const
   SEC_IN_MIN: Integer = 60;
Var
    Hours, Minutes, Seconds: Integer;
Begin
    GameTime := GameTime + 1; // увеличиваем на 1 (или на интервал таймера)
    PaintBox1.Invalidate;     //перерисовка по таймеру

    Hours   := GameTime Div (SEC_IN_MIN * SEC_IN_MIN);
    Minutes := (GameTime Div SEC_IN_MIN) Mod SEC_IN_MIN;
    Seconds := GameTime Mod SEC_IN_MIN;
    TimeLabel.Caption := Format('¬рем€: %.2d:%.2d:%.2d', [Hours, Minutes, Seconds]);
End;

End.
